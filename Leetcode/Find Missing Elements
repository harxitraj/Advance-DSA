class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        int n = nums.length;
        ArrayList<Integer> list = new ArrayList<>();
        Set<Integer> set = new HashSet<>();
        int min = nums[0];
        int max = nums[0];
        for(int i = 0; i < n; i++) {
            if(nums[i] < min) {
                min = nums[i];
            }
            if(nums[i] > max) {
                max = nums[i];
            }
            set.add(nums[i]);
        }

        for(int i = min; i < max; i++) {
            if(set.contains(i) == false) {
                list.add(i);
            }
        }
        return list;
    }
}
