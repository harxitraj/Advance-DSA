class Solution {
    public int reverseDegree(String s) {
        int n = s.length();
        int revDegree = 0;
        for(int i = 0; i < n; i++) {
            char curr = s.charAt(i);
            int currVal = 'z' - curr + 1;
            revDegree += currVal * (i+1);
        }

        return revDegree;
    }
}
