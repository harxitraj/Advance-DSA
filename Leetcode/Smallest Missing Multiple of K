class Solution {
    public int missingMultiple(int[] nums, int k) {
        int n = nums.length;
        int count = 1;
        Set<Integer> set = new HashSet<>();
        for(int i = 0; i < n; i++) {
            set.add(nums[i]);
        }
        for(int i = 0; i < n; i++) {
            int curr = k * count;
            count++;
            if(set.contains(curr) == false) {
                return curr;
            }
        }
        return k * count;
    }
}
